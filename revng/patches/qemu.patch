diff --git a/libtcg/win32/test-libtcg.c b/libtcg/win32/test-libtcg.c
new file mode 100644
index 0000000..85d57b9
--- /dev/null
+++ b/libtcg/win32/test-libtcg.c
@@ -0,0 +1,123 @@
+/*
+ * Fathom: test of libtcg on Windows. Loads libtcg-<target>.dll as rev.ng does
+ * (dlopen, then libtcg_load), translates a few x86 instructions to TCG and
+ * checks what rev.ng relies on: the CPU state offsets (env_offset, xmm0 / st0
+ * at the offsets of lib/Model/Register.cpp plus the Windows delta 0x30), the
+ * globals (registers) and the translated operations.
+ *
+ *   test-libtcg <libtcg-x86_64.dll | libtcg-i386.dll>
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+#include <windows.h>
+
+#include "libtcg/libtcg.h"
+
+static int failures;
+
+static void check(const char *what, bool ok)
+{
+    printf("%s %s\n", ok ? "ok  " : "FAIL", what);
+    if (!ok) {
+        failures++;
+    }
+}
+
+static intptr_t global_offset(LibTcgArchInfo *info, const char *name)
+{
+    for (int i = 0; i < info->num_globals; i++) {
+        if (info->globals[i].name && strcmp(info->globals[i].name, name) == 0) {
+            return info->globals[i].offset;
+        }
+    }
+    return -1;
+}
+
+int main(int argc, char **argv)
+{
+    if (argc < 2) {
+        fprintf(stderr, "usage: test-libtcg <libtcg dll>\n");
+        return 2;
+    }
+    bool x86_64 = strstr(argv[1], "x86_64") != NULL;
+    HMODULE dll = LoadLibraryExA(argv[1], NULL, LOAD_WITH_ALTERED_SEARCH_PATH);
+    check("the DLL loads", dll != NULL);
+    if (!dll) {
+        fprintf(stderr, "LoadLibrary: error %lu\n", GetLastError());
+        return 1;
+    }
+    LIBTCG_FUNC_TYPE(libtcg_load) *load =
+        (LIBTCG_FUNC_TYPE(libtcg_load) *) GetProcAddress(dll, "libtcg_load");
+    check("libtcg_load exported", load != NULL);
+    if (!load) {
+        return 1;
+    }
+    LibTcgInterface tcg = load();
+    LibTcgContext *context = tcg.context_create();
+    check("context created", context != NULL);
+    LibTcgArchInfo info = tcg.get_arch_info();
+    printf("     %s: %u globals, env_offset 0x%llx, pc 0x%llx, sp 0x%llx\n",
+           info.arch_cpu_name ? info.arch_cpu_name : "?", info.num_globals,
+           (unsigned long long) info.env_offset, (unsigned long long) info.pc,
+           (unsigned long long) info.sp);
+
+    /* the offsets rev.ng hardcodes (lib/Model/Register.cpp), plus 0x30 on Windows */
+    const char *ax = x86_64 ? "rax" : "eax";
+    check("the accumulator is a global", global_offset(&info, ax) >= 0);
+    check("pc and sp known", info.pc != 0 && info.sp != 0);
+
+    /* mov rax, rbx; add rax, 1; movaps xmm0, xmm1; ret (i386: the 32-bit forms) */
+    static const unsigned char code64[] = { 0x48, 0x89, 0xd8, 0x48, 0x83, 0xc0, 0x01,
+                                            0x0f, 0x28, 0xc1, 0xc3 };
+    static const unsigned char code32[] = { 0x89, 0xd8, 0x83, 0xc0, 0x01, 0x0f, 0x28, 0xc1, 0xc3 };
+    const unsigned char *code = x86_64 ? code64 : code32;
+    size_t size = x86_64 ? sizeof(code64) : sizeof(code32);
+    LibTcgTranslationBlock block = tcg.translate_block(context, code, size, 0x401000, 0);
+    printf("     %zu TCG instructions for %zu bytes (%zu translated)\n", block.instruction_count, size,
+           block.size_in_bytes);
+    check("the block is translated", block.instruction_count > 5 && block.size_in_bytes == size);
+
+    bool add = false, call = false, exit = false, xmm = false;
+    /* xmm0 in CPUX86State: 0x2b10 + 0x30 - env_offset (x86_64), as the static assertions of cpu.h */
+    const uint64_t xmm0 = 0x2b10 + 0x30 - info.env_offset;
+    char text[256];
+    for (size_t i = 0; i < block.instruction_count; i++) {
+        LibTcgInstruction *insn = &block.list[i];
+        tcg.dump_instruction_to_buffer(insn, text, sizeof(text));
+        if (i < 40) {
+            printf("       %s\n", text);
+        }
+        const char *name = tcg.get_instruction_name(insn->opcode);
+        if (strncmp(name, "add_i", 5) == 0) {
+            add = true;
+        }
+        if (insn->opcode == LIBTCG_op_call) {
+            call = true;
+        }
+        if (strcmp(name, "exit_tb") == 0 || strcmp(name, "goto_ptr") == 0 || strcmp(name, "goto_tb") == 0) {
+            exit = true;
+        }
+        /* movaps: a copy within env, from xmm1 to xmm0 (offsets as constants) */
+        for (int c = 0; c < insn->nb_cargs; c++) {
+            if (insn->constant_args[c].kind == LIBTCG_ARG_CONSTANT && insn->constant_args[c].constant == xmm0) {
+                xmm = true;
+            }
+        }
+        if (strstr(text, "xmm_regs") || strstr(text, "xmm0")) {
+            xmm = true;
+        }
+    }
+    check("add translated", add);
+    check("ret ends the block", exit || call);
+    if (x86_64) {
+        check("movaps writes xmm0 at the offset rev.ng expects (0x2b40 from the CPU)", xmm);
+    }
+    tcg.translation_block_destroy(context, block);
+    tcg.context_destroy(context);
+    printf("%s: %d failure(s)\n", argv[1], failures);
+    return failures ? 1 : 0;
+}
