index 1047d26..79b0aa5 100644
--- a/include/sysemu/os-win32.h
+++ b/include/sysemu/os-win32.h
@@ -265,6 +265,42 @@ win32_close_exception_handler(struct _EXCEPTION_RECORD*, void*,
 void *qemu_win32_map_alloc(size_t size, HANDLE *h, Error **errp);
 void qemu_win32_map_free(void *ptr, HANDLE h, Error **errp);
 
+/* CONFIG_LIBTCG_WIN32 is poisoned in the code common to all targets */
+#ifdef NEED_CPU_H
+#ifdef CONFIG_LIBTCG_WIN32
+/*
+ * Fathom: libtcg on Windows builds QEMU's user-mode code without linux-user.
+ * It names sigset_t (only with _POSIX in MinGW) and protects the pages of
+ * translated code with mprotect, restoring the signal mask after a write to
+ * them (never reached: libtcg translates, it does not run code).
+ */
+#ifndef _POSIX
+typedef _sigset_t sigset_t;
+#endif
+#define PROT_NONE  0
+#define PROT_READ  1
+#define PROT_WRITE 2
+#define PROT_EXEC  4
+static inline int mprotect(void *addr, size_t len, int prot)
+{
+    DWORD old, flags;
+    if (prot & PROT_EXEC) {
+        flags = prot & PROT_WRITE ? PAGE_EXECUTE_READWRITE
+              : prot & PROT_READ ? PAGE_EXECUTE_READ : PAGE_EXECUTE;
+    } else {
+        flags = prot & PROT_WRITE ? PAGE_READWRITE
+              : prot & PROT_READ ? PAGE_READONLY : PAGE_NOACCESS;
+    }
+    return VirtualProtect(addr, len, flags, &old) ? 0 : -1;
+}
+#define SIG_SETMASK 2
+static inline int sigprocmask(int how, const sigset_t *set, sigset_t *old)
+{
+    return 0;
+}
+#endif
+#endif
+
