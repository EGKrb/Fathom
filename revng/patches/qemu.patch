diff --git a/libtcg/win32-user.c b/libtcg/win32-user.c
new file mode 100644
index 0000000..1115bd0
--- /dev/null
+++ b/libtcg/win32-user.c
@@ -0,0 +1,202 @@
+/*
+ * Fathom: libtcg on Windows, without linux-user.
+ *
+ * libtcg only needs QEMU's front ends (gen_intermediate_code) and a CPU in the
+ * state a user-mode process starts in: on Linux, linux-user provides it
+ * (target_cpu_copy_regs). Here, the x86 CPU is set up directly, as the
+ * CONFIG_LIBTCG path of linux-user/i386/cpu_loop.c does: protected mode,
+ * paging, long mode for x86_64, flat segments whose caches are loaded
+ * directly (no GDT, so no guest memory).
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#include "qemu/osdep.h"
+#include "qemu/sockets.h"
+#include "cpu.h"
+#include "exec/exec-all.h"
+
+#if !defined(TARGET_I386)
+#error "libtcg on Windows: only the x86 targets (i386-libtcg, x86_64-libtcg)"
+#endif
+
+/* The selectors of Linux (arch/x86/include/asm/segment.h), as linux-user */
+#ifdef TARGET_X86_64
+#define WIN32_USER_CS 0x33
+#define WIN32_USER_DS 0x2b
+#else
+#define WIN32_USER_CS 0x23
+#define WIN32_USER_DS 0x2b
+#endif
+
+const char *cpu_get_model(uint32_t eflags)
+{
+    return "max";
+}
+
+void libtcg_win32_setup_cpu(CPUArchState *env)
+{
+    bool is64 = (env->features[FEAT_8000_0001_EDX] & CPUID_EXT2_LM) != 0;
+    uint32_t flat = 0x000f0000 | DESC_G_MASK | DESC_B_MASK | DESC_P_MASK
+                    | DESC_S_MASK | DESC_A_MASK | (3 << DESC_DPL_SHIFT);
+    uint32_t data = flat | (0x2 << DESC_TYPE_SHIFT);
+    uint32_t code = flat | (0xa << DESC_TYPE_SHIFT);
+
+    env->cr[0] = CR0_PG_MASK | CR0_WP_MASK | CR0_PE_MASK;
+    env->hflags |= HF_PE_MASK | HF_CPL_MASK;
+    if (env->features[FEAT_1_EDX] & CPUID_SSE) {
+        env->cr[4] |= CR4_OSFXSR_MASK;
+        env->hflags |= HF_OSFXSR_MASK;
+    }
+    if (is64) {
+        env->cr[4] |= CR4_PAE_MASK;
+        env->efer |= MSR_EFER_LMA | MSR_EFER_LME;
+        env->hflags |= HF_LMA_MASK;
+    }
+    env->eflags |= IF_MASK;
+
+#ifdef TARGET_X86_64
+    code |= DESC_L_MASK;
+    cpu_x86_load_seg_cache(env, R_CS, WIN32_USER_CS, 0, 0xffffffff, code);
+    cpu_x86_load_seg_cache(env, R_SS, WIN32_USER_DS, 0, 0xffffffff, data);
+    cpu_x86_load_seg_cache(env, R_DS, 0, 0, 0, 0);
+    cpu_x86_load_seg_cache(env, R_ES, 0, 0, 0, 0);
+    cpu_x86_load_seg_cache(env, R_FS, 0, 0, 0, 0);
+    cpu_x86_load_seg_cache(env, R_GS, 0, 0, 0, 0);
+#else
+    cpu_x86_load_seg_cache(env, R_CS, WIN32_USER_CS, 0, 0xffffffff, code);
+    cpu_x86_load_seg_cache(env, R_SS, WIN32_USER_DS, 0, 0xffffffff, data);
+    cpu_x86_load_seg_cache(env, R_DS, WIN32_USER_DS, 0, 0xffffffff, data);
+    cpu_x86_load_seg_cache(env, R_ES, WIN32_USER_DS, 0, 0xffffffff, data);
+    cpu_x86_load_seg_cache(env, R_FS, 0, 0, 0xffffffff, data);
+    cpu_x86_load_seg_cache(env, R_GS, WIN32_USER_DS, 0, 0xffffffff, data);
+#endif
+}
+
+/*
+ * What linux-user provides to the rest of QEMU's user-mode code. libtcg
+ * translates, it does not run guest code: the paths that would deliver a
+ * signal to the guest or kick a running CPU are not reached.
+ */
+
+/* linux-user/mmap.c: the lock of the guest's memory map (recursive per thread) */
+static __thread int mmap_lock_count;
+static GRecMutex mmap_mutex;
+
+void mmap_lock(void)
+{
+    if (mmap_lock_count++ == 0) {
+        g_rec_mutex_lock(&mmap_mutex);
+    }
+}
+
+void mmap_unlock(void)
+{
+    assert(mmap_lock_count > 0);
+    if (--mmap_lock_count == 0) {
+        g_rec_mutex_unlock(&mmap_mutex);
+    }
+}
+
+bool have_mmap_lock(void)
+{
+    return mmap_lock_count > 0;
+}
+
+/* linux-user/signal.c: a fault of the guest */
+void cpu_loop_exit_sigsegv(CPUState *cpu, target_ulong addr,
+                           MMUAccessType access_type, bool maperr,
+                           uintptr_t ra)
+{
+    fprintf(stderr, "libtcg: guest fault at 0x" TARGET_FMT_lx "\n", addr);
+    abort();
+}
+
+void cpu_loop_exit_sigbus(CPUState *cpu, target_ulong addr,
+                          MMUAccessType access_type, uintptr_t ra)
+{
+    fprintf(stderr, "libtcg: guest alignment fault at 0x" TARGET_FMT_lx "\n",
+            addr);
+    abort();
+}
+
+/* linux-user/main.c */
+void qemu_cpu_kick(CPUState *cpu)
+{
+    cpu_exit(cpu);
+}
+
+bool qemu_cpu_is_self(CPUState *cpu)
+{
+    return true;
+}
+
+uint64_t cpu_get_tsc(CPUX86State *env)
+{
+    return cpu_get_host_ticks();
+}
+
+/* util/qemu-sockets.c (not built here), used by util/oslib-win32.c */
+bool fd_is_socket(int fd)
+{
+    int optval;
+    socklen_t optlen = sizeof(optval);
+    return !getsockopt(fd, SOL_SOCKET, SO_TYPE, &optval, &optlen);
+}
+
+/* gdbstub/user-target.c (the debugging of a Linux process): no gdbstub here */
+#include "../gdbstub/internals.h"
+
+int gdb_get_cpu_index(CPUState *cpu)
+{
+    return cpu->cpu_index + 1;
+}
+
+int gdb_signal_to_target(int sig)
+{
+    return sig;
+}
+
+int gdb_target_signal_to_gdb(int sig)
+{
+    return sig;
+}
+
+static void gdb_unsupported(GArray *params, void *user_ctx)
+{
+    gdb_put_packet("");
+}
+
+void gdb_handle_query_offsets(GArray *params, void *user_ctx)
+{
+    gdb_unsupported(params, user_ctx);
+}
+
+void gdb_handle_v_file_open(GArray *params, void *user_ctx)
+{
+    gdb_unsupported(params, user_ctx);
+}
+
+void gdb_handle_v_file_close(GArray *params, void *user_ctx)
+{
+    gdb_unsupported(params, user_ctx);
+}
+
+void gdb_handle_v_file_pread(GArray *params, void *user_ctx)
+{
+    gdb_unsupported(params, user_ctx);
+}
+
+void gdb_handle_v_file_readlink(GArray *params, void *user_ctx)
+{
+    gdb_unsupported(params, user_ctx);
+}
+
+void gdb_handle_query_xfer_exec_file(GArray *params, void *user_ctx)
+{
+    gdb_unsupported(params, user_ctx);
+}
+
+/* linux-user/main.c: guest addresses are host addresses (libtcg reads the code from a buffer) */
+uintptr_t guest_base;
+bool have_guest_base;
+unsigned long reserved_va;
diff --git a/libtcg/win32/gen-helpers.py b/libtcg/win32/gen-helpers.py
new file mode 100644
index 0000000..3185388
--- /dev/null
+++ b/libtcg/win32/gen-helpers.py
@@ -0,0 +1,136 @@
+#!/usr/bin/env python3
+#
+# Fathom: libtcg-helpers-<target>.bc for libtcg on Windows.
+#
+# On Linux, the -llvm-helpers targets of QEMU compile the helpers (the C
+# functions the translated code calls: target/i386/tcg/*_helper.c, softfloat...)
+# with clang into an emulator that embeds their bitcode, and
+# python/scripts/link-embedded-objects extracts and links it. That build needs
+# linux-user. Here, the same sources are compiled to bitcode directly, with the
+# options of the Windows libtcg build (compile_commands.json): the structures
+# (CPUX86State, its offset in X86CPU) are then those of libtcg-<target>.dll.
+# linux-user's files are left out (system calls, signals: not used to decompile).
+#
+# SPDX-License-Identifier: GPL-2.0-or-later
+#
+#   gen-helpers.py <build dir> <clang> <llvm-link> <output dir> [target ...]
+import json
+import re
+import os
+import shlex
+import subprocess
+import sys
+
+COMMON = [
+    'accel/tcg/tcg-runtime.c',
+    'accel/tcg/tcg-runtime-gvec.c',
+    'accel/tcg/cpu-exec-common.c',
+    'accel/tcg/user-exec.c',
+    'util/cutils.c',
+    'util/error.c',
+    'util/interval-tree.c',
+    'fpu/softfloat.c',
+    'trace/control.c',
+    'stubs/iothread-lock.c',
+]
+X86 = [
+    'target/i386/tcg/misc_helper.c',
+    'target/i386/tcg/translate.c',
+    'target/i386/tcg/bpt_helper.c',
+    'target/i386/tcg/cc_helper.c',
+    'target/i386/tcg/excp_helper.c',
+    'target/i386/tcg/fpu_helper.c',
+    'target/i386/tcg/int_helper.c',
+    'target/i386/tcg/mem_helper.c',
+    'target/i386/tcg/mpx_helper.c',
+    'target/i386/tcg/seg_helper.c',
+    'target/i386/tcg/user/seg_helper.c',
+    'target/i386/helper.c',
+    # Fathom: what linux-user gives to the helpers (not built on Windows)
+    'libtcg/win32/helpers-win32.c',
+]
+# files of this directory: compiled with the options of a file of the target
+REFERENCE = 'target/i386/helper.c'
+HELPERS = {'x86_64': X86, 'i386': X86}
+
+# options of GCC that clang does not know, or that only matter for the object code
+DROP = {'-fno-pie', '-no-pie', '-pthread', '-MD', '-Winvalid-pch', '-fstack-protector-strong'}
+DROP_PREFIX = ('-W', '-fdiagnostics-color')
+DROP_WITH_VALUE = {'-MQ', '-MF', '-o'}
+
+
+def compile_options(entry, source, output, clang):
+    arguments = entry.get('arguments') or shlex.split(entry['command'], posix=True)
+    result = [clang]
+    skip = False
+    for argument in arguments[1:]:
+        if skip:
+            skip = False
+            continue
+        if argument in DROP_WITH_VALUE:
+            skip = True
+            continue
+        if argument in DROP or argument.startswith(DROP_PREFIX) or argument == '-c':
+            continue
+        if os.path.normpath(os.path.join(entry['directory'], argument)) == os.path.normpath(source):
+            continue
+        result.append(argument)
+    # as the -llvm-helpers targets: GEN_LLVM_HELPERS (revng's sections, no GETPC...)
+    return result + ['-DGEN_LLVM_HELPERS', '-Wno-everything', '-emit-llvm', '-c', source, '-o', output]
+
+
+def main():
+    build, clang, llvm_link, out_dir = (os.path.abspath(a) for a in sys.argv[1:5])
+    targets = sys.argv[5:] or list(HELPERS)
+    entries = json.load(open(os.path.join(build, 'compile_commands.json')))
+    os.makedirs(out_dir, exist_ok=True)
+    status = 0
+    for target in targets:
+        library = f'libqemu-{target}-libtcg'
+        work = os.path.join(build, f'helpers-{target}')
+        os.makedirs(work, exist_ok=True)
+        bitcode = []
+        for relative in COMMON + HELPERS[target]:
+            own_file = relative.startswith('libtcg/win32/')
+            lookup = REFERENCE if own_file else relative
+            # the options of this file in this target's library, else in a common library
+            candidates = [e for e in entries if os.path.normpath(e['file']).replace('\\', '/').endswith('/' + lookup)
+                          or os.path.normpath(os.path.join(e['directory'], e['file'])).replace('\\', '/').endswith('/' + lookup)]
+            own = [e for e in candidates if library in e.get('output', '') or library in e.get('command', '')]
+            entry = (own or candidates or [None])[0]
+            if entry is None:
+                print(f'{target}: no compile options for {relative}', file=sys.stderr)
+                status = 1
+                continue
+            # the source in the options (the reference's, for a file of this directory)
+            listed = os.path.normpath(os.path.join(entry['directory'], entry['file']))
+            source = listed
+            if own_file:
+                source = os.path.normpath(os.path.join(os.path.dirname(os.path.abspath(__file__)), '..', '..', relative))
+            output = os.path.join(work, relative.replace('/', '_') + '.bc')
+            command = compile_options(entry, listed, output, clang)
+            command[command.index('-c') + 1] = source
+            run = subprocess.run(command, cwd=entry['directory'], capture_output=True, text=True)
+            if run.returncode != 0:
+                print(f'{target}: {relative} failed:\n{run.stderr[-3000:]}', file=sys.stderr)
+                status = 1
+                continue
+            bitcode.append(output)
+        if status == 0:
+            result = os.path.join(out_dir, f'libtcg-helpers-{target}.bc')
+            linked = os.path.join(work, 'linked.ll')
+            subprocess.run([llvm_link, '-S', *bitcode, '-o', linked], check=True)
+            # What compiling for Windows adds and rev.ng's passes do not expect (they give bodies to some
+            # declarations): dllimport (glib's functions), and !dbg on declarations (call site information)
+            text = open(linked, encoding='utf-8').read()
+            text = re.sub(r'\bdllimport ', '', text)
+            text = re.sub(r'^declare !dbg ![0-9]+ ', 'declare ', text, flags=re.M)
+            open(linked, 'w', encoding='utf-8', newline='\n').write(text)
+            llvm_as = os.path.join(os.path.dirname(llvm_link), 'llvm-as' + os.path.splitext(llvm_link)[1])
+            subprocess.run([llvm_as, linked, '-o', result], check=True)
+            print(f'{result}: {len(bitcode)} files')
+    return status
+
+
+if __name__ == '__main__':
+    sys.exit(main())
diff --git a/libtcg/win32/helpers-win32.c b/libtcg/win32/helpers-win32.c
new file mode 100644
index 0000000..916fd4d
--- /dev/null
+++ b/libtcg/win32/helpers-win32.c
@@ -0,0 +1,130 @@
+/*
+ * Fathom: what linux-user gives to the helpers' bitcode (the -llvm-helpers
+ * targets, GEN_LLVM_HELPERS), for libtcg on Windows, where linux-user is not
+ * built. rev.ng looks these up in libtcg-helpers-<target>.bc:
+ *
+ * - arch_cpu_type_beacon (linux-user/main.c): finds the ArchCPU type in the IR;
+ * - invoke_handle_exception / handle_exception: what the CPU loop does with an
+ *   exception (cpu_loop_exit): the system calls, as in linux-user's x86
+ *   cpu_loop.c under GEN_LLVM_HELPERS, the others end in abort();
+ * - helper_initialize_env: the initial state of the CPU, with the flat segments
+ *   of a user-mode process (their caches loaded directly, as libtcg does on
+ *   Windows: libtcg/win32-user.c).
+ *
+ * do_syscall stays a declaration: the system calls of the analyzed program are
+ * calls to it in the lifted code.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#include "qemu/osdep.h"
+#include "qemu/thread.h"
+#include "cpu.h"
+#include "exec/exec-all.h"
+#include "exec/user/abitypes.h"
+
+#if !defined(TARGET_I386)
+#error "helpers-win32.c: x86 targets only"
+#endif
+
+ArchCPU arch_cpu_type_beacon;
+
+abi_long do_syscall(CPUArchState *cpu_env, int num, abi_long arg1,
+                    abi_long arg2, abi_long arg3, abi_long arg4,
+                    abi_long arg5, abi_long arg6, abi_long arg7,
+                    abi_long arg8);
+void handle_exception(CPUArchState *env, int trapnr);
+void invoke_handle_exception(CPUState *cpu);
+void helper_initialize_env(CPUArchState *env);
+
+/* linux-user's errno values for a restarted system call and sigreturn */
+#define WIN32_QEMU_ERESTARTSYS 512
+#define WIN32_QEMU_ESIGRETURN 513
+
+void handle_exception(CPUX86State *env, int trapnr)
+{
+    abi_ulong ret;
+
+    switch (trapnr) {
+    case 0x80:
+#ifndef TARGET_X86_64
+    case EXCP_SYSCALL:
+#endif
+        /* int $0x80 */
+        ret = do_syscall(env, env->regs[R_EAX], env->regs[R_EBX],
+                         env->regs[R_ECX], env->regs[R_EDX], env->regs[R_ESI],
+                         env->regs[R_EDI], env->regs[R_EBP], 0, 0);
+        env->eip = env->exception_next_eip;
+        if (ret == -WIN32_QEMU_ERESTARTSYS) {
+            env->eip -= 2;
+        } else if (ret != -WIN32_QEMU_ESIGRETURN) {
+            env->regs[R_EAX] = ret;
+        }
+        break;
+#ifdef TARGET_X86_64
+    case EXCP_SYSCALL:
+        /* syscall */
+        ret = do_syscall(env, env->regs[R_EAX], env->regs[R_EDI],
+                         env->regs[R_ESI], env->regs[R_EDX], env->regs[10],
+                         env->regs[8], env->regs[9], 0, 0);
+        env->eip = env->exception_next_eip;
+        if (ret == -WIN32_QEMU_ERESTARTSYS) {
+            env->eip -= 2;
+        } else if (ret != -WIN32_QEMU_ESIGRETURN) {
+            env->regs[R_EAX] = ret;
+        }
+        break;
+#endif
+    default:
+        abort();
+    }
+}
+
+void invoke_handle_exception(CPUState *cpu)
+{
+    handle_exception(cpu_env(cpu), cpu->exception_index);
+}
+
+/* The selectors of Linux, as linux-user and libtcg/win32-user.c */
+#ifdef TARGET_X86_64
+#define WIN32_HELPERS_USER_CS 0x33
+#else
+#define WIN32_HELPERS_USER_CS 0x23
+#endif
+#define WIN32_HELPERS_USER_DS 0x2b
+
+void helper_initialize_env(CPUX86State *env)
+{
+    uint32_t flat = 0x000f0000 | DESC_G_MASK | DESC_B_MASK | DESC_P_MASK
+                    | DESC_S_MASK | DESC_A_MASK | (3 << DESC_DPL_SHIFT);
+    uint32_t data = flat | (0x2 << DESC_TYPE_SHIFT);
+    uint32_t code = flat | (0xa << DESC_TYPE_SHIFT);
+
+    CC_SRC = env->eflags & (CC_O | CC_S | CC_Z | CC_A | CC_P | CC_C);
+    env->df = 1 - (2 * ((env->eflags >> 10) & 1));
+    CC_OP = CC_OP_EFLAGS;
+    env->eflags &= ~(DF_MASK | CC_O | CC_S | CC_Z | CC_A | CC_P | CC_C);
+
+#ifdef TARGET_X86_64
+    code |= DESC_L_MASK;
+    cpu_x86_load_seg_cache(env, R_CS, WIN32_HELPERS_USER_CS, 0, 0xffffffff,
+                           code);
+    cpu_x86_load_seg_cache(env, R_SS, WIN32_HELPERS_USER_DS, 0, 0xffffffff,
+                           data);
+    cpu_x86_load_seg_cache(env, R_DS, 0, 0, 0, 0);
+    cpu_x86_load_seg_cache(env, R_ES, 0, 0, 0, 0);
+    cpu_x86_load_seg_cache(env, R_FS, 0, 0, 0, 0);
+    cpu_x86_load_seg_cache(env, R_GS, 0, 0, 0, 0);
+#else
+    cpu_x86_load_seg_cache(env, R_CS, WIN32_HELPERS_USER_CS, 0, 0xffffffff,
+                           code);
+    cpu_x86_load_seg_cache(env, R_SS, WIN32_HELPERS_USER_DS, 0, 0xffffffff,
+                           data);
+    cpu_x86_load_seg_cache(env, R_DS, WIN32_HELPERS_USER_DS, 0, 0xffffffff,
+                           data);
+    cpu_x86_load_seg_cache(env, R_ES, WIN32_HELPERS_USER_DS, 0, 0xffffffff,
+                           data);
+    cpu_x86_load_seg_cache(env, R_FS, 0, 0, 0xffffffff, data);
+    cpu_x86_load_seg_cache(env, R_GS, WIN32_HELPERS_USER_DS, 0, 0xffffffff,
+                           data);
+#endif
+}
