+    LoadInst *NewLoad = Builder.CreateAlignedLoad(IntType,
+                                                  Load->getPointerOperand(),
+                                                  Load->getAlign(),
+                                                  Load->isVolatile());
+    NewLoad->copyMetadata(*Load);
+    Value *Cast = Builder.CreateBitCast(NewLoad, Load->getType());
+    Load->replaceAllUsesWith(Cast);
+    Load->eraseFromParent();
+    return NewLoad;
+  }
